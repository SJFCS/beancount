option "title" "Liability Sign Demo"
option "operating_currency" "USD"
2023-01-01 open Assets:Cash                         USD
2023-01-01 open Equity:Opening-Balances             USD
2024-01-01 open Liabilities:Mortgage                USD
2024-01-01 open Liabilities:CreditCard              USD
2024-01-01 open Expenses:Household                  USD
2024-01-01 open Expenses:Mortgage:Interest          USD
2024-01-01 open Expenses:Groceries                  USD
2024-01-01 open Income:Salary                       USD
;; Start with 10,000 cash.
2023-12-31 * "Opening balance"
  Assets:Cash                                 10000.00 USD
  Equity:Opening-Balances                    -10000.00 USD
;; Borrow 5,000 cash. Assets +5,000, liabilities increase by 5,000.
2024-02-01 * "Borrow mortgage"
  Assets:Cash                                  5000.00 USD
  Liabilities:Mortgage                        -5000.00 USD
;; Spend 1,000 of the borrowed cash.
2024-03-01 * "Buy household goods"
  Expenses:Household                           1000.00 USD
  Assets:Cash                                 -1000.00 USD
;; Buy 978 of groceries on the credit card.
;; This creates 978 of expense and 978 of new debt, but no cash inflow.
2024-04-01 * "Buy groceries with credit card"
  Expenses:Groceries                            978.00 USD
  Liabilities:CreditCard                       -978.00 USD
;; Repay 2,000 of mortgage principal. Debt falls, cash falls.
2025-03-01 * "Repay mortgage principal"
  Liabilities:Mortgage                         2000.00 USD
  Assets:Cash                                 -2000.00 USD
;; Repay the 978 credit-card balance. Debt falls, cash falls.
2025-03-15 * "Repay credit card"
  Liabilities:CreditCard                        978.00 USD
  Assets:Cash                                  -978.00 USD
;; Interest is an expense, not a principal repayment.
2025-04-01 * "Pay mortgage interest"
  Expenses:Mortgage:Interest                    100.00 USD
  Assets:Cash                                  -100.00 USD
;; Salary received in cash.
2025-06-01 * "Salary"
  Assets:Cash                                  3000.00 USD
  Income:Salary                               -3000.00 USD